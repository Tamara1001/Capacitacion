  m_Script: {fileID: 11500000, guid: 37828433a881bef4181a45aa0524477c, type: 3}
  m_Name: DLG_NotifyRestore
  m_EditorClassIdentifier: LotoSim.Runtime::LotoSim.Interaction.DialogueDefinition
  _speaker: Operador
  _line: "\xBFTerminaste con la P-101?"
  _options:
  - _text: "Termin\xE9. Voy a retirar los bloqueos y arrancar la bomba: mantenete
      alejado del equipo."
    _isCorrect: 1
    _flag: notify.restore
    _feedback: "Operador avisado. Pod\xE9s retirar los bloqueos."
  - _text: "Ya est\xE1, arrancala vos cuando quieras."
    _isCorrect: 0
    _flag: 
    _feedback: "Quien coloc\xF3 el bloqueo debe retirarlo y restablecer el equipo
      de forma controlada."
  - _text: No hace falta avisar, ya termino.
    _isCorrect: 0
    _flag: 
    _feedback: "Hay que avisar al personal afectado antes de restablecer la energ\xEDa."
