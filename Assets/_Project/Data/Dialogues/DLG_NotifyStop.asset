  m_Script: {fileID: 11500000, guid: 37828433a881bef4181a45aa0524477c, type: 3}
  m_Name: DLG_NotifyStop
  m_EditorClassIdentifier: LotoSim.Runtime::LotoSim.Interaction.DialogueDefinition
  _speaker: Operador
  _line: "Hola, \xBFnecesit\xE1s algo de la P-101?"
  _options:
  - _text: "Voy a revisar la bomba, vos segu\xED trabajando normal."
    _isCorrect: 0
    _flag: 
    _feedback: No informaste que el equipo va a quedar fuera de servicio.
  - _text: "Voy a bloquear la P-101 para cambiar el sello mec\xE1nico. Queda fuera
      de servicio hasta que te avise."
    _isCorrect: 1
    _flag: notify.stop
    _feedback: "Operador notificado. Ahora deten\xE9 la bomba con su mando normal."
  - _text: "Apag\xE1 todo el sector, voy a trabajar."
    _isCorrect: 0
    _flag: 
    _feedback: "Mensaje impreciso: hay que indicar qu\xE9 equipo se interviene y
      por qu\xE9."
