      m_Calls: []
  m_text: "<size=125%><b>\xBFQu\xE9 es LOTO?</b></size>\n\nLockout/Tagout es el procedimiento
    que asegura que un equipo <b>no pueda energizarse</b> mientras alguien lo interviene.\n\nCada
    fuente de energ\xEDa se <b>a\xEDsla</b>, se <b>bloquea</b> con un candado personal
    y se <b>identifica</b> con una etiqueta."
  m_isRightToLeft: 0
