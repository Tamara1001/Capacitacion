  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#C9CDD2>Aplic\xE1 el procedimiento de control de energ\xEDas peligrosas
    sobre una bomba centr\xEDfuga antes de su mantenimiento: preparar, comunicar,
    aislar, bloquear y etiquetar, liberar la energ\xEDa almacenada, verificar y restablecer.\n\nBasado
    en OSHA 29 CFR 1910.147.</color>"
